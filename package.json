{
  "name": "luxe-on-demand-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "verify:backend": "node scripts/verify-backend-config.mjs",
    "verify:health": "node scripts/verify-health-contract.mjs",
    "verify": "npm run verify:backend && npm run verify:health && npm run typecheck && npm run build && npm audit --omit=dev --audit-level=critical",
    "ios:build": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:run": "npx cap run ios",
    "android:build": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "postcss": "8.5.25",
    "brace-expansion": "5.0.9",
    "sharp": "0.35.3",
    "tar": "7.5.22",
    "ws": "8.21.1"
  }
}
